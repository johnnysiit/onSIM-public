[Unit]
Description=onSIM Asterisk container

[Container]
Image=localhost/onsim:latest
ContainerName=onsim-asterisk
Network=host
Exec=asterisk
Volume=%h/.local/share/onsim:/var/lib/onsim
Volume=asterisk-run.volume:/run/asterisk
HealthCmd=asterisk -rx 'core show uptime'
HealthInterval=30s
HealthTimeout=5s

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
