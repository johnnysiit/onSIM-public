{
  "id": "/",
  "name": "onSIM 电话与短信",
  "short_name": "onSIM",
  "description": "在手机上管理电话、短信、语音留言和设备状态",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#101825",
  "background_color": "#f3f6f8",
  "categories": ["utilities", "communication"],
  "shortcuts": [
    { "name": "拨打电话", "short_name": "拨号", "url": "/dial", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "查看短信", "short_name": "短信", "url": "/messages", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "打开设置", "short_name": "设置", "url": "/settings", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "prefer_related_applications": false
}
