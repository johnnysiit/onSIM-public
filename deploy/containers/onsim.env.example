ONSIM_LISTEN=0.0.0.0:8989
ONSIM_HTTP_LISTEN=0.0.0.0:8989
ONSIM_TLS_LISTEN=0.0.0.0:9443
ONSIM_TLS_CERT=/var/lib/onsim/tls/onsim.crt
ONSIM_TLS_KEY=/var/lib/onsim/tls/onsim.key
ONSIM_TLS_CA=/var/lib/onsim/tls/onsim-ca.crt
ONSIM_DATA_DIR=/var/lib/onsim
ONSIM_MASTER_KEY=/var/lib/onsim/master.key
ONSIM_AT_PORT=/dev/onsim-at
ONSIM_AUDIO_PORT=/dev/onsim-audio
ONSIM_CONTROL_PORT=/dev/onsim-control
ONSIM_MODEM_MODE=auto
ONSIM_GATEWAY_MODE=android
ONSIM_ANDROID_SERIAL=REPLACE_WITH_ADB_SERIAL
# 多手机时使用 JSON 数组；每个设备必须具有唯一 id/serial。未指定端口时
# 从 47100/47101 开始自动为每台手机分配独立的 ADB 转发端口。
# ONSIM_ANDROID_GATEWAYS=[{"id":"phone-a","serial":"REPLACE_WITH_FIRST_ADB_SERIAL"},{"id":"phone-b","serial":"REPLACE_WITH_SECOND_ADB_SERIAL"}]
ONSIM_ANDROID_SUBSCRIPTION_ID=auto
ONSIM_ANDROID_ADB_HOME=/var/lib/onsim/adb
ONSIM_ANDROID_ADB_SERVER_SOCKET=tcp:127.0.0.1:5038
ONSIM_ANDROID_TOKEN=/var/lib/onsim/android.token
ONSIM_ANDROID_CONTROL_ADDR=127.0.0.1:47100
ONSIM_ANDROID_AUDIO_ADDR=127.0.0.1:47101
ONSIM_PUBLIC_URL=https://onsim.local:9443
ONSIM_SESSION_HOURS=12
ONSIM_SIP_LISTEN=127.0.0.1:5062
ONSIM_SIP_ASTERISK=127.0.0.1:5060
ONSIM_SIP_TARGET=1001
ONSIM_ASTERISK_CONFIG=/var/lib/onsim/asterisk/pjsip-generated.conf
