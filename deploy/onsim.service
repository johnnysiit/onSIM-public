[Unit]
Description=onSIM telephony gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onsim
Group=onsim
SupplementaryGroups=dialout
EnvironmentFile=-/etc/onsim/onsim.env
ExecStart=/usr/local/bin/onsim
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onsim
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryMax=420M
TasksMax=128

[Install]
WantedBy=multi-user.target
